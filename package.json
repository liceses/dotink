{
  "name": "dotink",
  "version": "2.1.0",
  "description": "点墨 · 1-bit 成像标准与参考实现（场 / 渲染 / 判据 / 宿主 拆件 + 可选 HUD 叠加层）+ 现象画廊 + 厂标墙 + 字版厂标 + 即插即用 logo 组件 + hero 示例",
  "keywords": ["halftone", "1-bit", "dither", "dot-screen", "printing", "canvas", "dot-ink", "deterministic", "phenomena", "gallery", "brand-marks", "typeplate", "logo-overlay", "hero"],
  "license": "MIT",
  "type": "commonjs",
  "main": "dotink.js",
  "exports": {
    ".": "./dotink.js",
    "./fields.js": "./fields.js",
    "./render.js": "./render.js",
    "./judge.js": "./judge.js",
    "./host.js": "./host.js",
    "./hud.js": "./hud.js",
    "./pheno.js": "./pheno.js",
    "./marks.js": "./marks.js",
    "./markplate.js": "./markplate.js",
    "./logo.js": "./logo.js",
    "./transition.js": "./transition.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dotink.js", "fields.js", "render.js", "judge.js", "host.js", "hud.js", "pheno.js", "transition.js",
    "gallery.html", "hero.html", "preview.html", "marks.html", "marks-type.html", "logo-demo.html", "icon.html", "transition.html", "ink.css",
    "marks.js", "markplate.js", "logo.js",
    "icon.svg", "icon-512.png", "icon-192.png", "icon-64.png", "icon-32.png",
    "tools", "check", "docs", "demo",
    "media/*.png", "media/*.gif", "media/*.mp4", "media/phenomena-8",
    "STANDARD.md", "SKILL.md", "NOTICE.md", "README.md", "CHANGELOG.md", "LICENSE"
  ],
  "scripts": {
    "gallery": "node -e \"console.log('open gallery.html in a browser')\"",
    "hero": "node -e \"console.log('open hero.html in a browser')\"",
    "marks": "node -e \"console.log('open marks.html in a browser')\"",
    "marks-type": "node -e \"console.log('open marks-type.html in a browser')\"",
    "logo": "node -e \"console.log('open logo-demo.html in a browser')\"",
    "preview": "node -e \"console.log('open preview.html in a browser')\"",
    "check": "node --test check/core.mjs check/transition.mjs && node tools/check-links.mjs",
    "prepublishOnly": "npm run check"
  },
  "private": false
}
